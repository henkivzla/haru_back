# =============================================================================
# Haru POS — PRODUCCIÓN cPanel (henki.com.ve)
# cPanel → Setup Node.js App → Environment Variables (copia cada variable)
# =============================================================================

PORT=5000
NODE_ENV=production
MAIL_ENV=production

DB_HOST=localhost
DB_USER=cpanel_usuario_haru
DB_PASSWORD=clave_mysql_cpanel
DB_NAME=cpanel_haru_db

JWT_SECRET=genera_clave_larga_solo_produccion
CORS_ORIGIN=https://henki.com.ve
FRONTEND_URL=https://henki.com.ve
API_PUBLIC_URL=https://api.henki.com.ve
UPLOAD_DIR=/home/TU_USUARIO/haru-pos-backend/uploads

# ── CORREO cPanel (olvidé contraseña + aviso reporte de pago) ─────────────────
MAIL_PROVIDER=smtp
SMTP_HOST=mail.henki.com.ve
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=haru@henki.com.ve
SMTP_PASS=contraseña_del_buzón_cpanel
SMTP_FROM=Haru POS <haru@henki.com.ve>

# Correo del admin que recibe avisos cuando un cliente reporta un pago
PAYMENT_NOTIFY_EMAIL=gomezeiborth@gmail.com

# Solo si el hosting exige desactivar verificación TLS (raro):
# SMTP_TLS_REJECT_UNAUTHORIZED=false

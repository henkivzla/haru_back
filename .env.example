# Haru — plantilla .env LOCAL (XAMPP + npm run dev)
# Copia a .env y completa SMTP_PASS con la contraseña del buzón cPanel.

PORT=5000
HOST=0.0.0.0
NODE_ENV=development
MAIL_ENV=local

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=haru_db
JWT_SECRET=cambia_esta_clave
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Opcional en producción: orígenes permitidos en enlaces de correo (separados por coma).
# Si no se define, se usa el dominio desde el que el usuario abrió la app.
# ALLOWED_FRONTEND_ORIGINS=https://tu-dominio.ve,https://www.tu-dominio.ve
API_PUBLIC_URL=http://localhost:5000
UPLOAD_DIR=./uploads

# ── CORREO cPanel — henki.com.ve ─────────────────────────────────────────────
# Misma cuenta SMTP en local y producción. Crea el buzón en cPanel → Email Accounts.
# SMTP_USER debe ser el correo EXACTO del buzón (ej. haru@henki.com.ve).
MAIL_PROVIDER=smtp
SMTP_HOST=mail.henki.com.ve
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=haru@henki.com.ve
SMTP_PASS=tu_contraseña_del_buzón
SMTP_FROM=Haru <haru@henki.com.ve>

# Admin: recibe correo cuando alguien reporta un pago de suscripción
PAYMENT_NOTIFY_EMAIL=gomezeiborth@gmail.com

# WhatsApp admin — aviso rápido al reportar pago (CallMeBot: callmebot.com)
WHATSAPP_NOTIFY_PHONE=584228180393
WHATSAPP_CALLMEBOT_API_KEY=

# Política de suscripción (opcional)
# SUBSCRIPTION_WARNING_DAYS=3
# SUBSCRIPTION_GRACE_DAYS=2

# Si 587 falla por tu ISP, prueba: SMTP_PORT=465 y SMTP_SECURE=true
